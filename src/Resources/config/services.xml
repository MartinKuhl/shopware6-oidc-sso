<?xml version="1.0" ?>

<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd">

    <parameters>
        <parameter key="sw6oidc.default_log_level">debug</parameter>
        <!-- Dev-only escape hatches, both off unless the env var is set to 1. -->
        <parameter key="env(SW6OIDC_ALLOW_INSECURE_IDP_URLS)">0</parameter>
        <parameter key="env(SW6OIDC_ALLOW_PASSWORD_LOGIN)">0</parameter>
    </parameters>

    <services>
        <!-- Entity definitions -->
        <service id="MartinKuhl\Sw6Oidc\Core\Content\Provider\Sw6OidcProviderDefinition">
            <tag name="shopware.entity.definition" entity="sw6oidc_provider" />
        </service>

        <service id="MartinKuhl\Sw6Oidc\Core\Content\AttributeMapping\Sw6OidcAttributeMappingDefinition">
            <tag name="shopware.entity.definition" entity="sw6oidc_attribute_mapping" />
        </service>

        <service id="MartinKuhl\Sw6Oidc\Core\Content\RoleMapping\Sw6OidcRoleMappingDefinition">
            <tag name="shopware.entity.definition" entity="sw6oidc_role_mapping" />
        </service>

        <service id="MartinKuhl\Sw6Oidc\Core\Content\AccessControlRule\Sw6OidcAccessControlRuleDefinition">
            <tag name="shopware.entity.definition" entity="sw6oidc_access_control_rule" />
        </service>

        <service id="MartinKuhl\Sw6Oidc\Core\Content\UserProvider\Sw6OidcUserProviderDefinition">
            <tag name="shopware.entity.definition" entity="sw6oidc_user_provider" />
        </service>

        <service id="MartinKuhl\Sw6Oidc\Core\Content\PasskeyCredential\Sw6OidcPasskeyCredentialDefinition">
            <tag name="shopware.entity.definition" entity="sw6oidc_passkey_credential" />
        </service>

        <!--
            Atomic one-time-token cache (PKCE verifiers, state tokens, OIDC/Passkey
            nonces). RedisAtomicCache picks its backend at runtime: Redis GETDEL
            when SW6OIDC_REDIS_DSN is set (required for multi-node HA), otherwise
            sequential get+delete against Shopware's own cache.app pool
            (CachePoolAtomicCache, single-node safe).
        -->
        <service id="MartinKuhl\Sw6Oidc\Service\Cache\CachePoolAtomicCache">
            <argument type="service" id="cache.app" />
        </service>

        <service id="MartinKuhl\Sw6Oidc\Service\Cache\RedisConnectionFactory">
            <argument>%env(default::SW6OIDC_REDIS_DSN)%</argument>
            <argument type="service" id="MartinKuhl\Sw6Oidc\Service\Logging\OidcLogger" />
        </service>

        <service id="MartinKuhl\Sw6Oidc\Service\Cache\RedisAtomicCache">
            <argument type="service" id="MartinKuhl\Sw6Oidc\Service\Cache\RedisConnectionFactory" />
            <argument type="service" id="MartinKuhl\Sw6Oidc\Service\Cache\CachePoolAtomicCache" />
            <argument type="service" id="MartinKuhl\Sw6Oidc\Service\Logging\OidcLogger" />
        </service>
        <service id="MartinKuhl\Sw6Oidc\Service\Cache\AtomicCacheInterface" alias="MartinKuhl\Sw6Oidc\Service\Cache\RedisAtomicCache" />

        <!-- Encryption at rest (client_secret). Key derived from APP_SECRET. -->
        <service id="MartinKuhl\Sw6Oidc\Service\Security\Sw6OidcEncryptor">
            <argument>%env(APP_SECRET)%</argument>
            <argument type="service" id="MartinKuhl\Sw6Oidc\Service\Logging\OidcLogger" />
        </service>

        <!-- Service id must be the class name: Field::getSerializer() resolves it by class. -->
        <service id="MartinKuhl\Sw6Oidc\Core\Content\Provider\Field\Sw6OidcEncryptedFieldSerializer">
            <argument type="service" id="Shopware\Core\Framework\DataAbstractionLayer\FieldSerializer\StringFieldSerializer" />
            <argument type="service" id="MartinKuhl\Sw6Oidc\Service\Security\Sw6OidcEncryptor" />
            <tag name="shopware.field_serializer" />
        </service>

        <!--
            HTTP client for every outbound IdP call: NoPrivateNetworkHttpClient-wrapped
            (resolved-IP check on each connection/redirect) unless
            SW6OIDC_ALLOW_INSECURE_IDP_URLS=1.
        -->
        <service id="sw6oidc.http_client" class="Symfony\Contracts\HttpClient\HttpClientInterface">
            <factory class="MartinKuhl\Sw6Oidc\Service\Http\Sw6OidcHttpClientFactory" method="create" />
            <argument type="service" id="Symfony\Contracts\HttpClient\HttpClientInterface" />
            <argument>%env(bool:SW6OIDC_ALLOW_INSECURE_IDP_URLS)%</argument>
        </service>

        <service id="MartinKuhl\Sw6Oidc\Service\Jwt\JwtVerifier">
            <argument type="service" id="sw6oidc.http_client" />
            <argument type="service" id="cache.app" />
            <argument type="service" id="MartinKuhl\Sw6Oidc\Service\Logging\OidcLogger" />
        </service>

        <!--
            Standalone Monolog channel writing to var/log/sw6oidc-<env>.log, kept
            separate from Shopware's own `logger`/`monolog.logger.*` services so this
            plugin's verbose OIDC/Passkey flow logging never mixes into the app log.
        -->
        <service id="MartinKuhl\Sw6Oidc\Service\Logging\SensitiveDataProcessor" />

        <service id="sw6oidc.log_handler" class="Monolog\Handler\StreamHandler">
            <argument>%kernel.logs_dir%/sw6oidc-%kernel.environment%.log</argument>
            <argument>%env(default:sw6oidc.default_log_level:SW6OIDC_LOG_LEVEL)%</argument>
        </service>

        <service id="MartinKuhl\Sw6Oidc\Service\Logging\OidcLogger" class="Monolog\Logger">
            <argument>sw6oidc</argument>
            <argument type="collection">
                <argument type="service" id="sw6oidc.log_handler" />
            </argument>
            <argument type="collection">
                <argument type="service" id="MartinKuhl\Sw6Oidc\Service\Logging\SensitiveDataProcessor" />
            </argument>
        </service>

        <service id="MartinKuhl\Sw6Oidc\Service\Security\OidcSecurityHelper">
            <argument type="service" id="MartinKuhl\Sw6Oidc\Service\Cache\AtomicCacheInterface" />
        </service>

        <service id="MartinKuhl\Sw6Oidc\Service\Http\OidcHttpClient">
            <argument type="service" id="sw6oidc.http_client" />
            <argument type="service" id="MartinKuhl\Sw6Oidc\Service\Logging\OidcLogger" />
        </service>

        <service id="MartinKuhl\Sw6Oidc\Service\Oidc\TokenExchangeService">
            <argument type="service" id="MartinKuhl\Sw6Oidc\Service\Http\OidcHttpClient" />
        </service>

        <service id="MartinKuhl\Sw6Oidc\Service\Oidc\UserInfoService">
            <argument type="service" id="MartinKuhl\Sw6Oidc\Service\Http\OidcHttpClient" />
        </service>

        <service id="MartinKuhl\Sw6Oidc\Service\Oidc\ClaimsNormalizer" />

        <service id="MartinKuhl\Sw6Oidc\Service\Oidc\OidcDiscoveryService">
            <argument type="service" id="MartinKuhl\Sw6Oidc\Service\Http\OidcHttpClient" />
        </service>

        <service id="MartinKuhl\Sw6Oidc\Service\Security\SsrfUrlValidator">
            <argument>%env(bool:SW6OIDC_ALLOW_INSECURE_IDP_URLS)%</argument>
        </service>

        <service id="MartinKuhl\Sw6Oidc\Service\Oidc\OidcConnectionTestService">
            <argument type="service" id="MartinKuhl\Sw6Oidc\Service\Http\OidcHttpClient" />
            <argument type="service" id="MartinKuhl\Sw6Oidc\Service\Oidc\OidcDiscoveryService" />
            <argument type="service" id="MartinKuhl\Sw6Oidc\Service\Security\SsrfUrlValidator" />
        </service>

        <service id="MartinKuhl\Sw6Oidc\Service\Oidc\TestResultTranslator" />

        <service id="MartinKuhl\Sw6Oidc\Service\Oidc\OidcLiveLoginTestService">
            <argument type="service" id="MartinKuhl\Sw6Oidc\Service\Oidc\TokenExchangeService" />
            <argument type="service" id="MartinKuhl\Sw6Oidc\Service\Oidc\UserInfoService" />
            <argument type="service" id="MartinKuhl\Sw6Oidc\Service\Jwt\JwtVerifier" />
            <argument type="service" id="MartinKuhl\Sw6Oidc\Service\Oidc\ClaimsNormalizer" />
        </service>

        <!-- Provisioning / group mapping -->
        <service id="MartinKuhl\Sw6Oidc\Service\Provisioning\UserProviderBindingService">
            <argument type="service" id="sw6oidc_user_provider.repository" />
        </service>

        <service id="MartinKuhl\Sw6Oidc\Service\Provisioning\GroupMappingResolver">
            <argument type="service" id="sw6oidc_role_mapping.repository" />
        </service>

        <service id="MartinKuhl\Sw6Oidc\Service\Provisioning\GenderMapper" />

        <service id="MartinKuhl\Sw6Oidc\Service\Provisioning\TimeZoneValidator" />

        <service id="MartinKuhl\Sw6Oidc\Service\Provisioning\CountryResolver">
            <argument type="service" id="country.repository" />
            <argument type="service" id="country_state.repository" />
        </service>

        <service id="MartinKuhl\Sw6Oidc\Service\Provisioning\AttributeTransformer">
            <argument type="service" id="MartinKuhl\Sw6Oidc\Service\Logging\OidcLogger" />
        </service>

        <service id="MartinKuhl\Sw6Oidc\Service\Provisioning\AttributeMapper">
            <argument type="service" id="sw6oidc_attribute_mapping.repository" />
            <argument type="service" id="MartinKuhl\Sw6Oidc\Service\Provisioning\GenderMapper" />
            <argument type="service" id="MartinKuhl\Sw6Oidc\Service\Provisioning\AttributeTransformer" />
            <argument type="service" id="event_dispatcher" />
        </service>

        <service id="MartinKuhl\Sw6Oidc\Service\Provisioning\CustomerProvisioningService">
            <argument type="service" id="customer.repository" />
            <argument type="service" id="salutation.repository" />
            <argument type="service" id="MartinKuhl\Sw6Oidc\Service\Provisioning\CountryResolver" />
            <argument type="service" id="MartinKuhl\Sw6Oidc\Service\Provisioning\GroupMappingResolver" />
            <argument type="service" id="MartinKuhl\Sw6Oidc\Service\Provisioning\UserProviderBindingService" />
            <argument type="service" id="Shopware\Core\System\NumberRange\ValueGenerator\NumberRangeValueGeneratorInterface" />
            <argument type="service" id="MartinKuhl\Sw6Oidc\Service\Logging\OidcLogger" />
            <argument type="service" id="event_dispatcher" />
        </service>

        <service id="MartinKuhl\Sw6Oidc\Service\Provisioning\AdminProvisioningService">
            <argument type="service" id="user.repository" />
            <argument type="service" id="locale.repository" />
            <argument type="service" id="media.repository" />
            <argument type="service" id="MartinKuhl\Sw6Oidc\Service\Provisioning\GroupMappingResolver" />
            <argument type="service" id="MartinKuhl\Sw6Oidc\Service\Provisioning\UserProviderBindingService" />
            <argument type="service" id="Shopware\Core\Content\Media\MediaService" />
            <argument type="service" id="Shopware\Core\Content\Media\File\FileFetcher" />
            <argument type="service" id="MartinKuhl\Sw6Oidc\Service\Provisioning\TimeZoneValidator" />
            <argument type="service" id="MartinKuhl\Sw6Oidc\Service\Logging\OidcLogger" />
            <argument type="service" id="event_dispatcher" />
        </service>

        <service id="MartinKuhl\Sw6Oidc\Service\Provider\ProviderResolver">
            <argument type="service" id="sw6oidc_provider.repository" />
        </service>

        <service id="MartinKuhl\Sw6Oidc\Service\Oidc\AuthorizationRequestBuilder">
            <argument type="service" id="MartinKuhl\Sw6Oidc\Service\Security\OidcSecurityHelper" />
            <argument type="service" id="MartinKuhl\Sw6Oidc\Service\Logging\OidcLogger" />
        </service>

        <service id="MartinKuhl\Sw6Oidc\Service\Oidc\OidcCallbackProcessor">
            <argument type="service" id="MartinKuhl\Sw6Oidc\Service\Provider\ProviderResolver" />
            <argument type="service" id="MartinKuhl\Sw6Oidc\Service\Security\OidcSecurityHelper" />
            <argument type="service" id="MartinKuhl\Sw6Oidc\Service\Oidc\TokenExchangeService" />
            <argument type="service" id="MartinKuhl\Sw6Oidc\Service\Oidc\UserInfoService" />
            <argument type="service" id="MartinKuhl\Sw6Oidc\Service\Jwt\JwtVerifier" />
            <argument type="service" id="MartinKuhl\Sw6Oidc\Service\Oidc\ClaimsNormalizer" />
            <argument type="service" id="MartinKuhl\Sw6Oidc\Service\Provisioning\AttributeMapper" />
            <argument type="service" id="MartinKuhl\Sw6Oidc\Service\Logging\OidcLogger" />
            <argument type="service" id="MartinKuhl\Sw6Oidc\Service\Security\Sw6OidcAccessControlEvaluator" />
        </service>

        <!-- Claims-based access control (evaluated inside OidcCallbackProcessor) -->
        <service id="MartinKuhl\Sw6Oidc\Service\Security\Sw6OidcAccessControlEvaluator">
            <argument type="service" id="sw6oidc_access_control_rule.repository" />
            <argument type="service" id="MartinKuhl\Sw6Oidc\Service\Logging\OidcLogger" />
        </service>

        <service id="MartinKuhl\Sw6Oidc\Service\AdminAuth\AdminLoginErrorTicketStore">
            <argument type="service" id="MartinKuhl\Sw6Oidc\Service\Cache\AtomicCacheInterface" />
        </service>

        <!-- Storefront -->
        <service id="MartinKuhl\Sw6Oidc\Storefront\Service\OidcCustomerLoginRoute">
            <argument type="service" id="event_dispatcher" />
            <argument type="service" id="customer.repository" />
            <argument type="service" id="Shopware\Core\System\SalesChannel\Context\CartRestorer" />
        </service>

        <service id="MartinKuhl\Sw6Oidc\Storefront\Controller\SendAuthorizationRequestController" public="true">
            <argument type="service" id="MartinKuhl\Sw6Oidc\Service\Provider\ProviderResolver" />
            <argument type="service" id="MartinKuhl\Sw6Oidc\Service\Oidc\AuthorizationRequestBuilder" />
            <argument type="service" id="MartinKuhl\Sw6Oidc\Service\Logging\OidcLogger" />
            <call method="setContainer">
                <argument type="service" id="service_container" />
            </call>
        </service>

        <service id="MartinKuhl\Sw6Oidc\Storefront\Controller\OidcCallbackController" public="true">
            <argument type="service" id="MartinKuhl\Sw6Oidc\Service\Oidc\OidcCallbackProcessor" />
            <argument type="service" id="MartinKuhl\Sw6Oidc\Service\Provisioning\CustomerProvisioningService" />
            <argument type="service" id="MartinKuhl\Sw6Oidc\Storefront\Service\OidcCustomerLoginRoute" />
            <argument type="service" id="Shopware\Core\System\SalesChannel\Context\SalesChannelContextService" />
            <argument type="service" id="MartinKuhl\Sw6Oidc\Service\Oidc\LogoutContextStore" />
            <argument type="service" id="MartinKuhl\Sw6Oidc\Service\Logging\OidcLogger" />
            <argument type="service" id="MartinKuhl\Sw6Oidc\Service\Session\Sw6OidcSessionRegistry" />
            <argument type="service" id="MartinKuhl\Sw6Oidc\Service\Security\Sw6OidcRateLimiter" />
            <call method="setContainer">
                <argument type="service" id="service_container" />
            </call>
        </service>

        <!--
            Session/subject registry (sub/sid -> local sessions) for Back-/Front-Channel
            Logout and forced logouts; see Sw6OidcSessionDestructionService for the
            customer-vs-admin destruction asymmetry.
        -->
        <service id="MartinKuhl\Sw6Oidc\Service\Session\Sw6OidcSessionRegistry">
            <argument type="service" id="cache.app" />
            <argument type="service" id="MartinKuhl\Sw6Oidc\Service\Logging\OidcLogger" />
        </service>

        <service id="MartinKuhl\Sw6Oidc\Service\Session\Sw6OidcSessionDestructionService">
            <argument type="service" id="Shopware\Core\System\SalesChannel\Context\SalesChannelContextPersister" />
            <argument type="service" id="Shopware\Core\Framework\Api\OAuth\RefreshTokenRepository" />
            <argument type="service" id="Doctrine\DBAL\Connection" />
            <argument type="service" id="MartinKuhl\Sw6Oidc\Service\Logging\OidcLogger" />
        </service>

        <service id="MartinKuhl\Sw6Oidc\Service\Session\Sw6OidcIdpLogoutHandler">
            <argument type="service" id="MartinKuhl\Sw6Oidc\Service\Session\Sw6OidcSessionRegistry" />
            <argument type="service" id="MartinKuhl\Sw6Oidc\Service\Session\Sw6OidcSessionDestructionService" />
            <argument type="service" id="MartinKuhl\Sw6Oidc\Service\Oidc\LogoutContextStore" />
            <argument type="service" id="MartinKuhl\Sw6Oidc\Service\Logging\OidcLogger" />
        </service>

        <!--
            Penalty-model rate limiting (only failed requests count) for the
            unauthenticated endpoints. cache.rate_limiter is Shopware's own pool;
            cache.app is the fallback if an installation doesn't define it.
        -->
        <service id="MartinKuhl\Sw6Oidc\Service\Security\Sw6OidcRateLimiter">
            <argument type="service" id="cache.rate_limiter" on-invalid="null" />
            <argument type="service" id="cache.app" />
        </service>

        <!-- OIDC Back-Channel Logout receiver -->
        <service id="MartinKuhl\Sw6Oidc\Controller\Oidc\BackChannelLogoutController" public="true">
            <argument type="service" id="MartinKuhl\Sw6Oidc\Service\Jwt\JwtVerifier" />
            <argument type="service" id="MartinKuhl\Sw6Oidc\Service\Provider\ProviderResolver" />
            <argument type="service" id="MartinKuhl\Sw6Oidc\Service\Session\Sw6OidcIdpLogoutHandler" />
            <argument type="service" id="MartinKuhl\Sw6Oidc\Service\Security\Sw6OidcRateLimiter" />
            <argument type="service" id="cache.app" />
            <argument type="service" id="MartinKuhl\Sw6Oidc\Service\Logging\OidcLogger" />
            <call method="setContainer">
                <argument type="service" id="service_container" />
            </call>
        </service>

        <!-- OIDC Front-Channel Logout receiver (always answers with a 1x1 GIF) -->
        <service id="MartinKuhl\Sw6Oidc\Controller\Oidc\FrontChannelLogoutController" public="true">
            <argument type="service" id="MartinKuhl\Sw6Oidc\Service\Provider\ProviderResolver" />
            <argument type="service" id="MartinKuhl\Sw6Oidc\Service\Session\Sw6OidcIdpLogoutHandler" />
            <argument type="service" id="MartinKuhl\Sw6Oidc\Service\Security\Sw6OidcRateLimiter" />
            <argument type="service" id="MartinKuhl\Sw6Oidc\Service\Logging\OidcLogger" />
            <call method="setContainer">
                <argument type="service" id="service_container" />
            </call>
        </service>

        <service id="MartinKuhl\Sw6Oidc\Service\Oidc\LogoutContextStore">
            <argument type="service" id="MartinKuhl\Sw6Oidc\Service\Cache\AtomicCacheInterface" />
        </service>

        <service id="MartinKuhl\Sw6Oidc\Service\Oidc\RpInitiatedLogoutService">
            <argument type="service" id="MartinKuhl\Sw6Oidc\Service\Http\OidcHttpClient" />
            <argument type="service" id="MartinKuhl\Sw6Oidc\Service\Logging\OidcLogger" />
        </service>

        <service id="MartinKuhl\Sw6Oidc\Storefront\Service\PendingLogoutRedirect">
            <tag name="kernel.reset" method="reset" />
        </service>

        <service id="MartinKuhl\Sw6Oidc\Storefront\Service\OidcLogoutRoute"
                 decorates="Shopware\Core\Checkout\Customer\SalesChannel\LogoutRoute">
            <argument type="service" id=".inner" />
            <argument type="service" id="MartinKuhl\Sw6Oidc\Service\Oidc\LogoutContextStore" />
            <argument type="service" id="MartinKuhl\Sw6Oidc\Service\Provider\ProviderResolver" />
            <argument type="service" id="MartinKuhl\Sw6Oidc\Service\Oidc\RpInitiatedLogoutService" />
            <argument type="service" id="MartinKuhl\Sw6Oidc\Storefront\Service\PendingLogoutRedirect" />
            <argument type="service" id="router" />
            <argument type="service" id="MartinKuhl\Sw6Oidc\Service\Logging\OidcLogger" />
        </service>

        <service id="MartinKuhl\Sw6Oidc\Storefront\EventSubscriber\CustomerLogoutSubscriber">
            <argument type="service" id="MartinKuhl\Sw6Oidc\Storefront\Service\PendingLogoutRedirect" />
            <tag name="kernel.event_subscriber" />
        </service>

        <!--
            Administration OIDC bridge — see the plan's "bridging pattern"
            section. AdminAuthorizationServer is the *real*
            League\OAuth2\Server\AuthorizationServer (already a transitive
            Shopware dependency), wired to Shopware's own OAuth repositories/
            signing key, with our AdminOidcGrant registered on it.
        -->
        <service id="MartinKuhl\Sw6Oidc\Service\AdminAuth\AdminOidcGrant">
            <argument type="service" id="Shopware\Core\Framework\Api\OAuth\RefreshTokenRepository" />
        </service>

        <service id="MartinKuhl\Sw6Oidc\Service\AdminAuth\AdminAuthorizationServerFactory">
            <argument type="service" id="Shopware\Core\Framework\Api\OAuth\ClientRepository" />
            <argument type="service" id="Shopware\Core\Framework\Api\OAuth\AccessTokenRepository" />
            <argument type="service" id="Shopware\Core\Framework\Api\OAuth\ScopeRepository" />
            <argument type="service" id="Shopware\Core\Framework\Api\OAuth\FakeCryptKey" />
            <argument>%env(APP_SECRET)%</argument>
            <argument type="service" id="MartinKuhl\Sw6Oidc\Service\AdminAuth\AdminOidcGrant" />
        </service>

        <!--
            Deliberately NOT aliased to the bare League\OAuth2\Server\AuthorizationServer
            class id — Shopware's own core almost certainly already defines a
            service for that exact class backing its real /api/oauth/token
            endpoint, and aliasing over it would either fail to compile or
            silently replace Shopware's own OAuth server. Always inject this by
            its own service id, never by the bare class name.
        -->
        <service id="MartinKuhl\Sw6Oidc\Service\AdminAuth\AdminAuthorizationServer" class="League\OAuth2\Server\AuthorizationServer" public="false">
            <factory service="MartinKuhl\Sw6Oidc\Service\AdminAuth\AdminAuthorizationServerFactory" method="create" />
        </service>

        <service id="MartinKuhl\Sw6Oidc\Service\AdminAuth\AdminLoginNonceService">
            <argument type="service" id="MartinKuhl\Sw6Oidc\Service\Cache\AtomicCacheInterface" />
        </service>

        <!--
            PSR-7 bridge for the in-process token-request round trip.
            Symfony\Bridge\PsrHttpMessage\Factory\PsrHttpFactory is NOT defined
            here — Symfony's FrameworkBundle auto-registers it (and
            HttpFoundationFactory) once nyholm/psr7 + symfony/psr-http-message-bridge
            are installed, exactly as the reference plugin relies on without
            defining it itself. Redefining the bare class id ourselves would
            risk the same collision called out above for AuthorizationServer.
        -->

        <!-- Passkey (WebAuthn) -->
        <service id="MartinKuhl\Sw6Oidc\Service\Passkey\PasskeyCredentialRepository">
            <argument type="service" id="sw6oidc_passkey_credential.repository" />
            <argument type="service" id="MartinKuhl\Sw6Oidc\Service\Passkey\WebauthnCeremonyFactory" />
            <argument type="service" id="MartinKuhl\Sw6Oidc\Service\Logging\OidcLogger" />
        </service>

        <service id="MartinKuhl\Sw6Oidc\Service\Passkey\WebauthnCeremonyFactory" />

        <service id="MartinKuhl\Sw6Oidc\Service\Passkey\PasskeyConfig">
            <argument type="service" id="Shopware\Core\System\SystemConfig\SystemConfigService" />
        </service>

        <service id="MartinKuhl\Sw6Oidc\Service\Passkey\PasskeyRegistrationService">
            <argument type="service" id="MartinKuhl\Sw6Oidc\Service\Passkey\WebauthnCeremonyFactory" />
            <argument type="service" id="MartinKuhl\Sw6Oidc\Service\Passkey\PasskeyCredentialRepository" />
            <argument type="service" id="MartinKuhl\Sw6Oidc\Service\Cache\AtomicCacheInterface" />
        </service>

        <service id="MartinKuhl\Sw6Oidc\Service\Passkey\PasskeyAuthenticationService">
            <argument type="service" id="MartinKuhl\Sw6Oidc\Service\Passkey\WebauthnCeremonyFactory" />
            <argument type="service" id="MartinKuhl\Sw6Oidc\Service\Passkey\PasskeyCredentialRepository" />
            <argument type="service" id="MartinKuhl\Sw6Oidc\Service\Cache\AtomicCacheInterface" />
        </service>

        <service id="MartinKuhl\Sw6Oidc\Controller\Api\OidcAdminAuthController" public="true">
            <argument type="service" id="MartinKuhl\Sw6Oidc\Service\Provider\ProviderResolver" />
            <argument type="service" id="MartinKuhl\Sw6Oidc\Service\Oidc\AuthorizationRequestBuilder" />
            <argument type="service" id="MartinKuhl\Sw6Oidc\Service\Oidc\OidcCallbackProcessor" />
            <argument type="service" id="MartinKuhl\Sw6Oidc\Service\Provisioning\AdminProvisioningService" />
