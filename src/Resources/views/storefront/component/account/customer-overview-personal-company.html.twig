{#
    Shopware core (index.html.twig's page_account_overview_profile_company
    block) unconditionally includes this partial, and the partial itself
    unconditionally wraps its content in a <p> - only the *content* (company
    name, VAT id) is behind an {% if %}. For a private/individual account
    (no company, no VAT id, the common case for an OIDC/Passkey-provisioned
    customer) that renders an empty <p></p> between the name and email
    lines on the account overview page, which still takes up a full line's
    worth of vertical space. Wrapping the whole parent() call in the same
    "is there actually anything to show" check core already uses inside the
    <p> removes that empty paragraph entirely instead of just its text.
#}
{% sw_extends '@Storefront/storefront/component/account/customer-overview-personal-company.html.twig' %}

{% block component_customer_overview_personal %}
    {% set hasCompany = customer.company %}
    {% set hasVatId = customer.vatIds and customer.vatIds|length > 0 and customer.vatIds[0] != '' %}

    {% if hasCompany or hasVatId %}
        {{ parent() }}
    {% endif %}
{% endblock %}
