{% block sw6oidc_provider_detail %}
<sw-page class="sw6oidc-provider-detail">
    {% block sw6oidc_provider_detail_smart_bar_actions %}
    <template #smart-bar-actions>
        <sw-button :router-link="{ name: 'sw6oidc.provider.index' }">
            {{ $tc('sw6oidc.provider.detail.buttonCancel') }}
        </sw-button>
        <sw-button-process
            variant="primary"
            :is-loading="isLoading"
            :process-success="isSaveSuccessful"
            @click="onClickSave"
        >
            {{ $tc('sw6oidc.provider.detail.buttonSave') }}
        </sw-button-process>
    </template>
    {% endblock %}

    {% block sw6oidc_provider_detail_content %}
    <template #content>
        <sw-card-view v-if="provider">
            <sw-card :title="$tc('sw6oidc.provider.detail.cardGeneral')">
                <sw-container columns="1fr 1fr" gap="0 30px">
                    <sw-text-field v-model="provider.appName" :label="$tc('sw6oidc.provider.detail.appName')" required />
                    <sw-text-field v-model="provider.displayName" :label="$tc('sw6oidc.provider.detail.displayName')" />
                </sw-container>
                <sw-container columns="1fr 1fr" gap="0 30px">
                    <sw-single-select
                        v-model:value="provider.loginType"
                        :label="$tc('sw6oidc.provider.detail.loginType.label')"
                        :options="loginTypeOptions"
                    />
                    <sw-number-field v-model="provider.sortOrder" :label="$tc('sw6oidc.provider.detail.sortOrder')" />
                </sw-container>
                <sw-container columns="1fr 1fr 1fr" gap="0 30px">
                    <sw-switch-field v-model:value="provider.isActive" :label="$tc('sw6oidc.provider.detail.isActive')" />
                    <sw-switch-field v-model:value="provider.showCustomerLink" :label="$tc('sw6oidc.provider.detail.showCustomerLink')" />
                    <sw-switch-field v-model:value="provider.showAdminLink" :label="$tc('sw6oidc.provider.detail.showAdminLink')" />
                </sw-container>
            </sw-card>

            <sw-card :title="$tc('sw6oidc.provider.detail.cardOAuth')">
                <sw-container columns="1fr 1fr" gap="0 30px">
                    <sw-text-field v-model="provider.clientId" :label="$tc('sw6oidc.provider.detail.clientId')" required />
                    <sw-password-field v-model="provider.clientSecret" :label="$tc('sw6oidc.provider.detail.clientSecret')" required />
                </sw-container>
                <sw-text-field v-model="provider.wellKnownConfigUrl" :label="$tc('sw6oidc.provider.detail.wellKnownConfigUrl')" />

                {% block sw6oidc_provider_detail_discovery_actions %}
                <sw-container columns="max-content max-content" gap="0 16px" style="margin-bottom: 16px;">
                    <sw-button
                        size="small"
                        :is-loading="isLoadingConfiguration"
                        :disabled="!provider.wellKnownConfigUrl"
                        @click="onClickLoadConfiguration"
                    >
                        {{ $tc('sw6oidc.provider.detail.buttonLoadConfiguration') }}
                    </sw-button>
                    <sw-button
                        size="small"
                        :is-loading="isTestingConnection"
                        @click="onClickTestConnection"
                    >
                        {{ $tc('sw6oidc.provider.detail.buttonTestConnection') }}
                    </sw-button>
                </sw-container>
                {% endblock %}

                {% block sw6oidc_provider_detail_connection_test_result %}
                <sw-card v-if="connectionTestResult" :title="$tc('sw6oidc.provider.detail.testConnectionResultTitle')" style="margin-bottom: 16px;">
                    <table class="sw6oidc-test-result-table">
                        <tbody>
                            <tr v-for="check in connectionTestResult.checks" :key="check.id">
                                <td>{{ $tc(`sw6oidc.provider.detail.testConnection.check.${check.id}`) }}</td>
                                <td>
                                    <sw-label :variant="check.status === 'pass' ? 'success' : (check.status === 'warning' ? 'warning' : 'danger')">
                                        {{ check.status }}
                                    </sw-label>
                                </td>
                                <td>{{ check.detail }}</td>
                            </tr>
                        </tbody>
                    </table>
                </sw-card>
                {% endblock %}

                <sw-container columns="1fr 1fr" gap="0 30px">
                    <sw-text-field v-model="provider.authorizeEndpoint" :label="$tc('sw6oidc.provider.detail.authorizeEndpoint')" />
                    <sw-text-field v-model="provider.accessTokenEndpoint" :label="$tc('sw6oidc.provider.detail.accessTokenEndpoint')" />
                </sw-container>
                <sw-container columns="1fr 1fr" gap="0 30px">
                    <sw-text-field v-model="provider.userInfoEndpoint" :label="$tc('sw6oidc.provider.detail.userInfoEndpoint')" />
                    <sw-text-field v-model="provider.jwksEndpoint" :label="$tc('sw6oidc.provider.detail.jwksEndpoint')" />
                </sw-container>
                <sw-container columns="1fr 1fr" gap="0 30px">
                    <sw-text-field v-model="provider.endSessionEndpoint" :label="$tc('sw6oidc.provider.detail.endSessionEndpoint')" />
                    <sw-text-field v-model="provider.revocationEndpoint" :label="$tc('sw6oidc.provider.detail.revocationEndpoint')" />
                </sw-container>
                <sw-container columns="1fr 1fr 1fr" gap="0 30px">
                    <sw-text-field v-model="provider.issuer" :label="$tc('sw6oidc.provider.detail.issuer')" />
                    <sw-text-field v-model="provider.scope" :label="$tc('sw6oidc.provider.detail.scope')" />
                    <sw-text-field v-model="provider.groupAttribute" :label="$tc('sw6oidc.provider.detail.groupAttribute')" />
                </sw-container>
                <sw-container columns="1fr 1fr 1fr" gap="0 30px">
                    <sw-single-select v-model:value="provider.pkceFlow" :label="$tc('sw6oidc.provider.detail.pkceFlow')" :options="pkceFlowOptions" />
                    <sw-single-select v-model:value="provider.claimEncoding" :label="$tc('sw6oidc.provider.detail.claimEncoding')" :options="claimEncodingOptions" />
                    <sw-switch-field v-model:value="provider.publicClient" :label="$tc('sw6oidc.provider.detail.publicClient')" />
                </sw-container>
                <sw-container columns="1fr 1fr" gap="0 30px">
                    <sw-number-field v-model="provider.httpTimeout" :label="$tc('sw6oidc.provider.detail.httpTimeout')" />
                    <sw-number-field v-model="provider.jwksCacheTtl" :label="$tc('sw6oidc.provider.detail.jwksCacheTtl')" />
                </sw-container>

                {% block sw6oidc_provider_detail_live_test %}
                <sw-container columns="max-content 1fr" gap="0 16px" style="align-items: center;">
                    <sw-button
                        size="small"
                        :is-loading="isRunningLiveTest"
                        :disabled="!canRunLiveTest"
                        :tooltip="canRunLiveTest ? null : { message: $tc('sw6oidc.provider.detail.liveTestRequiresSaveHint') }"
                        @click="onClickRunLiveTest"
                    >
                        {{ $tc('sw6oidc.provider.detail.buttonRunLiveTest') }}
                    </sw-button>
                    <span v-if="provider.lastTestStatus">
                        {{ $tc('sw6oidc.provider.detail.lastTestStatusLabel') }}:
                        <sw-label :variant="provider.lastTestStatus === 'pass' ? 'success' : 'danger'">
                            {{ provider.lastTestStatus }}
                        </sw-label>
                        <template v-if="provider.lastTestAt">({{ provider.lastTestAt }})</template>
                    </span>
                </sw-container>

                <sw-card
                    v-if="liveTestReport"
                    :title="$tc('sw6oidc.provider.detail.liveTestResultTitle')"
                    style="margin-top: 16px;"
                >
                    <table class="sw6oidc-test-result-table">
                        <tbody>
                            <tr v-for="step in liveTestReport.steps" :key="step.id">
                                <td>{{ $tc(`sw6oidc.provider.detail.liveTest.step.${step.id}`) }}</td>
                                <td>
                                    <sw-label :variant="step.status === 'pass' ? 'success' : (step.status === 'skipped' ? 'neutral' : 'danger')">
                                        {{ step.status }}
                                    </sw-label>
                                </td>
                                <td>{{ step.detail }}</td>
                            </tr>
                        </tbody>
                    </table>
                </sw-card>
                {% endblock %}
            </sw-card>

            {#
                Split into separate titled cards (Account creation /
                Superadmin grant / Login restrictions / Sync on every login)
                rather than one long "Provisioning & sync" card — matches
                the pattern already used for every other section on this
                page (General, OAuth, Attribute Mapping, Role Mapping are
                all their own card), and groups these ~14 toggles/fields by
                what they actually affect instead of one undifferentiated
                wall of switches.
            #}
            <sw-card :title="$tc('sw6oidc.provider.detail.cardProvisioningAccounts')">
                <sw-container columns="1fr 1fr" gap="0 30px">
                    <sw-switch-field
                        v-model:value="provider.autoCreateCustomer"
                        :label="$tc('sw6oidc.provider.detail.autoCreateCustomer')"
                        :help-text="$tc('sw6oidc.provider.detail.autoCreateCustomerHelp')"
                    />
                    <sw-switch-field
                        v-model:value="provider.autoCreateAdmin"
                        :label="$tc('sw6oidc.provider.detail.autoCreateAdmin')"
                        :help-text="$tc('sw6oidc.provider.detail.autoCreateAdminHelp')"
                    />
                </sw-container>
                <sw-container columns="1fr 1fr" gap="0 30px">
                    <sw-entity-single-select
                        v-model:value="provider.defaultCustomerGroupId"
                        entity="customer_group"
                        label-property="name"
                        :label="$tc('sw6oidc.provider.detail.defaultCustomerGroupId')"
                        :placeholder="$tc('sw6oidc.provider.detail.targetPlaceholderGroup')"
                        :help-text="$tc('sw6oidc.provider.detail.defaultCustomerGroupIdHelp')"
                    />
                    <sw-entity-single-select
                        v-model:value="provider.defaultAclRoleId"
                        entity="acl_role"
                        label-property="name"
                        :label="$tc('sw6oidc.provider.detail.defaultAclRoleId')"
                        :placeholder="$tc('sw6oidc.provider.detail.targetPlaceholderRole')"
                        :help-text="$tc('sw6oidc.provider.detail.defaultAclRoleIdHelp')"
                    />
                </sw-container>
                <mt-banner
                    v-if="adminProvisioningWarning"
                    variant="attention"
                >
                    {{ $tc('sw6oidc.provider.detail.adminProvisioningWarning') }}
                </mt-banner>
            </sw-card>

            <sw-card :title="$tc('sw6oidc.provider.detail.cardProvisioningSuperadmin')">
                <sw-container columns="1fr 1fr" gap="0 30px">
                    <sw-switch-field
                        v-model:value="provider.allowSuperadminGroupMapping"
                        :label="$tc('sw6oidc.provider.detail.allowSuperadminGroupMapping')"
                        :help-text="$tc('sw6oidc.provider.detail.allowSuperadminGroupMappingHelp')"
                    />
                </sw-container>
                <mt-banner
                    v-if="provider.allowSuperadminGroupMapping"
                    variant="critical"
                >
                    {{ $tc('sw6oidc.provider.detail.superadminMappingActiveWarning') }}
                </mt-banner>
            </sw-card>

            <sw-card :title="$tc('sw6oidc.provider.detail.cardProvisioningLoginRestrictions')">
                <sw-container columns="1fr 1fr" gap="0 30px">
                    <sw-switch-field
                        v-model:value="provider.disableNonOidcCustomerLogin"
                        :label="$tc('sw6oidc.provider.detail.disableNonOidcCustomerLogin')"
                        :help-text="$tc('sw6oidc.provider.detail.disableNonOidcCustomerLoginHelp')"
                    />
                    <sw-switch-field
                        v-model:value="provider.disableNonOidcAdminLogin"
                        :label="$tc('sw6oidc.provider.detail.disableNonOidcAdminLogin')"
                        :help-text="$tc('sw6oidc.provider.detail.disableNonOidcAdminLoginHelp')"
                    />
                </sw-container>
            </sw-card>

            <sw-card :title="$tc('sw6oidc.provider.detail.cardProvisioningSync')">
                <sw-container columns="1fr 1fr 1fr" gap="0 30px">
                    <sw-switch-field
                        v-model:value="provider.syncCustomerProfileOnSso"
                        :label="$tc('sw6oidc.provider.detail.syncCustomerProfileOnSso')"
                        :help-text="$tc('sw6oidc.provider.detail.syncCustomerProfileOnSsoHelp')"
                    />
                    <sw-switch-field
                        v-model:value="provider.syncCustomerAddressOnSso"
                        :label="$tc('sw6oidc.provider.detail.syncCustomerAddressOnSso')"
                        :help-text="$tc('sw6oidc.provider.detail.syncCustomerAddressOnSsoHelp')"
                    />
                    <sw-switch-field
                        v-model:value="provider.syncCustomerGroupOnSso"
                        :label="$tc('sw6oidc.provider.detail.syncCustomerGroupOnSso')"
                        :help-text="$tc('sw6oidc.provider.detail.syncCustomerGroupOnSsoHelp')"
                    />
                </sw-container>
                <sw-container columns="1fr 1fr" gap="0 30px">
                    <sw-switch-field
                        v-model:value="provider.syncAdminProfileOnSso"
                        :label="$tc('sw6oidc.provider.detail.syncAdminProfileOnSso')"
                        :help-text="$tc('sw6oidc.provider.detail.syncAdminProfileOnSsoHelp')"
                    />
                    <sw-switch-field
                        v-model:value="provider.syncAdminRoleOnSso"
                        :label="$tc('sw6oidc.provider.detail.syncAdminRoleOnSso')"
                        :help-text="$tc('sw6oidc.provider.detail.syncAdminRoleOnSsoHelp')"
                    />
                </sw-container>
            </sw-card>

            {% block sw6oidc_provider_detail_attribute_mappings %}
            <sw-card
                v-if="provider.attributeMappings"
                :title="$tc('sw6oidc.provider.detail.cardAttributeMapping')"
            >
                {#
                    The claim-name select below only ever offers claims from
                    the last live test's response (discoveredClaimKeys) - on
                    a freshly created provider, or one whose last test never
                    succeeded, that list is empty and the select has nothing
                    to pick, which otherwise looks broken rather than simply
                    "not tested yet".
                #}
                <mt-banner
                    v-if="!discoveredClaimKeys.length"
                    variant="info"
                    style="margin-bottom: 16px;"
                >
                    {{ $tc('sw6oidc.provider.detail.attributeMappingRequiresLiveTestHint') }}
                </mt-banner>
                <sw-data-grid
                    :data-source="provider.attributeMappings"
                    :columns="[
                        { property: 'attributeType', label: $tc('sw6oidc.provider.detail.attributeType.label'), width: '220px' },
                        { property: 'attributeName', label: $tc('sw6oidc.provider.detail.attributeClaimName'), width: '420px' },
                        { property: 'syncOnSso', label: $tc('sw6oidc.provider.detail.syncOnSso'), width: '220px' },
                    ]"
                    :show-selection="false"
                >
                    <template #column-attributeType="{ item }">
                        <sw-single-select v-model:value="item.attributeType" :options="attributeTypeOptions" size="small" />
                    </template>
                    {#
                        A plain select, same pattern as #column-attributeType
                        above: only claims actually observed on the last live
                        test (claimSelectOptions/discoveredClaimKeys) are ever
                        valid choices here — typing a claim name the IdP
                        doesn't actually send would just be a silent
                        misconfiguration, so there's no free-text fallback.
                        Empty (no live test run yet, or the test found no
                        claims) simply means nothing to pick — the select
                        still renders, just with an empty result list.
                    #}
                    <template #column-attributeName="{ item }">
                        <sw-single-select
                            v-model:value="item.attributeName"
                            :options="claimSelectOptions"
                            :placeholder="$tc('sw6oidc.provider.detail.pickDiscoveredClaimPlaceholder')"
                            size="small"
                        />
                    </template>
                    <template #column-syncOnSso="{ item }">
                        {#
                            mt-switch's own default CSS gives it margin-top:
                            24px (meant for standalone form spacing). The
                            data-grid's own CSS resets margin-bottom to 0 for
                            it but never touches margin-top, so left alone it
                            sits visibly low/off-center in the fixed-height
                            cell next to the other columns' fields. mt-switch
                            ships this exact modifier class for that case.
                        #}
                        <sw-switch-field class="mt-switch--no-top-margin" v-model:value="item.syncOnSso" />
                    </template>
                    <template #actions="{ item }">
                        <sw-context-menu-item variant="danger" @click="onRemoveAttributeMapping(item)">
                            {{ $tc('sw6oidc.provider.detail.remove') }}
                        </sw-context-menu-item>
                    </template>
                </sw-data-grid>
                <sw-button size="small" style="margin-top: 16px;" @click="onAddAttributeMapping">
                    {{ $tc('sw6oidc.provider.detail.addAttributeMapping') }}
                </sw-button>
            </sw-card>
            {% endblock %}

            {% block sw6oidc_provider_detail_role_mappings %}
            <sw-card
                v-if="provider.roleMappings"
                :title="$tc('sw6oidc.provider.detail.cardRoleMapping')"
            >
                <sw-data-grid
                    :data-source="provider.roleMappings"
                    :columns="[
                        { property: 'mappingType', label: $tc('sw6oidc.provider.detail.mappingType.label'), width: '220px' },
                        { property: 'oidcGroup', label: $tc('sw6oidc.provider.detail.oidcGroup') },
                        { property: 'target', label: $tc('sw6oidc.provider.detail.target') },
                        { property: 'sortOrder', label: $tc('sw6oidc.provider.detail.sortOrder') },
                    ]"
                    :show-selection="false"
                >
                    <template #column-mappingType="{ item }">
                        <sw-single-select
                            v-model:value="item.mappingType"
                            :options="mappingTypeOptions"
                            size="small"
                            @update:value="onMappingTypeChange(item)"
                        />
                    </template>
                    <template #column-oidcGroup="{ item }">
                        <sw-text-field v-model="item.oidcGroup" size="small" />
                    </template>
                    {#
                        Two separate selects, toggled by mappingType, rather than
                        one shared component — acl_role and customer_group are
                        different entities with no common base, so the picker
                        itself has to switch, not just its bound value.
                    #}
                    <template #column-target="{ item }">
                        <sw-entity-single-select
                            v-if="item.mappingType === 'admin_role'"
                            v-model:value="item.aclRoleId"
                            entity="acl_role"
                            label-property="name"
                            size="small"
                            :placeholder="$tc('sw6oidc.provider.detail.targetPlaceholderRole')"
                        />
                        <sw-entity-single-select
                            v-else-if="item.mappingType === 'customer_group'"
                            v-model:value="item.customerGroupId"
                            entity="customer_group"
                            label-property="name"
                            size="small"
                            :placeholder="$tc('sw6oidc.provider.detail.targetPlaceholderGroup')"
                        />
                        {#
                            'superadmin' rows need no target picker — they
                            grant the native superadmin flag directly, not an
                            ACL role or customer group.
                        #}
                        <span v-else>
                            {{ $tc('sw6oidc.provider.detail.targetSuperadmin') }}
                        </span>
                    </template>
                    <template #column-sortOrder="{ item }">
                        <sw-number-field v-model="item.sortOrder" size="small" />
                    </template>
                    <template #actions="{ item }">
                        <sw-context-menu-item variant="danger" @click="onRemoveRoleMapping(item)">
                            {{ $tc('sw6oidc.provider.detail.remove') }}
                        </sw-context-menu-item>
                    </template>
                </sw-data-grid>
                <sw-button size="small" style="margin-top: 16px;" @click="onAddRoleMapping">
                    {{ $tc('sw6oidc.provider.detail.addRoleMapping') }}
                </sw-button>
            </sw-card>
            {% endblock %}
        </sw-card-view>
    </template>
    {% endblock %}
</sw-page>
{% endblock %}
