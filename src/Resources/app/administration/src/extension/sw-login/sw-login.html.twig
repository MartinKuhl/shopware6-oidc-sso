{#
    sw_login_login_sso (wrapping Shopware's own native SSO-forwarding button)
    only exists as a named, overridable block in newer Shopware versions than
    the one this plugin was actually tested against (v6.7.14.0) - confirmed
    by checking out that exact tag from shopware/shopware and reading
    sw-login-login.html.twig directly: in that version the SSO <div> isn't
    wrapped in any block at all, so overriding sw_login_login_sso silently
    produced nothing (no build error, no button). sw_login_login - the
    outermost block wrapping the entire <form> - is the one block guaranteed
    to exist across versions, so our buttons render as a sibling after the
    form closes instead.
#}
{% block sw_login_login %}
{% parent %}

{#
    Plain <button>/<div> here, not <mt-button>/<mt-banner>: those render
    unstyled on this screen even though the exact same components work fine
    for core's own "Anmelden" button right above - most likely because
    whatever registers/styles them for real isn't ready yet on this
    forced-early render path either (see index.html.twig for why this
    plugin's JS runs this early at all). The class list below is copied
    verbatim from that real, working "Anmelden" button (inspected live) -
    mt-button's actual visual styling comes from these plain CSS classes,
    not from sw-login__login-action alone, so applying them directly to a
    plain <button> sidesteps depending on Meteor component resolution
    entirely. mt-button--primary/--block always apply; mt-button--disabled
    is added conditionally to match the real button's own behavior, and
    :disabled prevents the click itself while pending.
#}
<div class="sw6oidc-login-actions">
    <button
        type="button"
        class="mt-button mt-button--primary mt-button--default mt-button--block sw6oidc-login-actions__sso-button"
        @click="sw6oidcStartLogin"
    >
        {{ sw6oidcTranslate('sw6oidc.login.ssoButton', 'Login with SSO') }}
    </button>

    <button
        type="button"
        class="mt-button mt-button--primary mt-button--default mt-button--block sw6oidc-login-actions__passkey-button"
        :class="{ 'mt-button--disabled': sw6oidcPasskeyPending }"
        :disabled="sw6oidcPasskeyPending"
        @click="sw6oidcStartPasskeyLogin"
    >
        {{ sw6oidcTranslate('sw6oidc.login.passkeyButton', 'Login with Passkey') }}
    </button>

    <div
        v-if="sw6oidcExchangeError"
        class="sw6oidc-login-actions__error"
    >
        {{ sw6oidcTranslate('sw6oidc.login.error', 'Single sign-on login failed. Please try again or log in with your username and password.') }}
    </div>

    <div
        v-if="sw6oidcPasskeyError"
        class="sw6oidc-login-actions__error"
    >
        {{ sw6oidcTranslate('sw6oidc.login.passkeyError', 'Passkey login failed. Please try again or log in with your username and password.') }}
    </div>
</div>
{% endblock %}
