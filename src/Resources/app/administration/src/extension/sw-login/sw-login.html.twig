{#
    sw_login_login_sso (wrapping Shopware's own native SSO-forwarding button)
    only exists as a named, overridable block in newer Shopware versions than
    the one this plugin was actually tested against (v6.7.14.0) - confirmed
    by checking out that exact tag from shopware/shopware and reading
    sw-login-login.html.twig directly: in that version the SSO <div> isn't
    wrapped in any block at all, so overriding sw_login_login_sso silently
    produced nothing (no build error, no button). sw_login_login - the
    outermost block wrapping the entire <form> - is the one block guaranteed
    to exist across versions, so our buttons render as a sibling after the
    form closes instead.
#}
{% block sw_login_login %}
{% parent %}

<div class="sw6oidc-login-actions">
    <mt-button
        class="sw6oidc-login-actions__sso-button"
        :block="true"
        size="default"
        variant="secondary"
        @click="sw6oidcStartLogin"
    >
        {{ $tc('sw6oidc.login.ssoButton') }}
    </mt-button>

    <mt-button
        class="sw6oidc-login-actions__passkey-button"
        :is-loading="sw6oidcPasskeyPending"
        :disabled="sw6oidcPasskeyPending"
        :block="true"
        size="default"
        variant="secondary"
        @click="sw6oidcStartPasskeyLogin"
    >
        {{ $tc('sw6oidc.login.passkeyButton') }}
    </mt-button>

    <mt-banner
        v-if="sw6oidcExchangeError"
        variant="critical"
        :show-icon="true"
        :closable="false"
    >
        {{ $tc('sw6oidc.login.error') }}
    </mt-banner>

    <mt-banner
        v-if="sw6oidcPasskeyError"
        variant="critical"
        :show-icon="true"
        :closable="false"
    >
        {{ $tc('sw6oidc.login.passkeyError') }}
    </mt-banner>
</div>
{% endblock %}
